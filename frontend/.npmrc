# Nenhum pacote roda script de instalação (postinstall etc.): é por onde costuma entrar malware
# na cadeia de dependências. O Vite 8 e o TypeScript 7 trazem os binários nativos como
# dependências opcionais, sem precisar de script.
ignore-scripts=true
# Versão exata no package.json, nunca "^": atualizar é sempre uma decisão.
save-exact=true
