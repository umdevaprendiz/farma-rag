# Copie para .env (que fica fora do Git) e ajuste.
# Tudo que muda entre experimentos fica aqui, nunca fixo no código.

# --- Ollama (nativo no Windows; o container enxerga via host.docker.internal) ---
OLLAMA_URL=http://localhost:11434
# Esta máquina não tem GPU NVIDIA: tudo roda na CPU. Comece com 1-2B e deixe o benchmark decidir.
LLM_MODELO=qwen2.5:1.5b
# Modelo do nó verificar_llm (só na rodada 3). Vazio = o mesmo de LLM_MODELO. Um modelo maior
# aqui melhora a verificação sem deixar a pergunta comum mais lenta.
LLM_MODELO_VERIFICACAO=
EMBED_MODELO=bge-m3
# F3c (seção 35): quanto tempo o Ollama mantém os modelos na memória depois do último uso ("30m",
# "2h", "-1" = para sempre). Recarregar o qwen2.5:1.5b custa vários segundos na CPU.
KEEP_ALIVE=30m
# F3c: ao subir, a API carrega o modelo de geração, o de verificação (se houver) e o de embeddings no
# Ollama, em segundo plano, para a primeira pergunta não pagar a carga. A subida não espera nem
# falha se o Ollama estiver fora. false = não aquece.
AQUECER_MODELOS=true
# Precisa bater com EMBED_DIM em backend/app/db/models.py (coluna vector(N) em chunks)
EMBED_DIM=1024

# --- PostgreSQL 17 + pgvector (container "db" do docker-compose cria banco e usuário) ---
DB_USER=farmarag
DB_PASSWORD=troque-esta-senha
DB_NAME=farmarag
# "127.0.0.1" para scripts rodados no host (ingestão, benchmark, pytest). Não use "localhost":
# no Windows ele tenta o IPv6 (::1) primeiro, e a porta do Docker só existe no IPv4,
# então cada conexão nova espera ~130 s antes de cair no 127.0.0.1.
# O docker-compose.yml sobrescreve para "db":5432 dentro do container da API.
DB_HOST=127.0.0.1
# Porta publicada no host. Use 5433 se já houver um PostgreSQL nativo na 5432.
DB_PORT=5432
# Tempo máximo para abrir uma conexão. Sem ele, banco desligado faz cada conexão esperar ~130 s.
DB_TIMEOUT_S=5

# --- Busca e geração ---
TOP_K=3
# Reranking da rodada 1 (docs/DECISOES.md, seções 30 e 32): quantos candidatos por remédio entram
# antes de escolher os TOP_K pela seção, pelo assunto e sem repetir trecho. 0 = só semelhança.
RERANK_CANDIDATOS=10
# F3b (seção 34): a seção que a pergunta indica já na rodada 1 (um trecho dela por remédio) e as
# seções "resultados de eficácia" e "características farmacológicas" só na frente quando pedidas.
# false = o reranking da seção 30 sozinho (para comparar no benchmark: RERANK_GARANTE_SECAO=false).
RERANK_GARANTE_SECAO=true
# Pergunta sem medicamento indexado ("melhor remédio pra dor de cabeça"): busca em todas as bulas,
# um trecho por princípio ativo. Cada trecho a mais pesa ~5 s na leitura do prompt (CPU).
TOP_K_GERAL=4
# Vazio = ainda não calibrado (etapa 2/4). Escolher com as 10 perguntas sem resposta do benchmark.
LIMIAR_SIMILARIDADE=
CHUNK_TOKENS=300
CHUNK_SOBREPOSICAO=50
TEMPERATURA=0.1
# Semente da geração: vazia no uso normal. Com ela, o mesmo prompt dá a mesma resposta (o benchmark
# completo fixa uma, para comparar configurações sem o sorteio da temperatura no meio).
LLM_SEMENTE=
NUM_CTX=4096
NUM_PREDICT=250
# Em CPU a geração é lenta; ajuste depois de medir na etapa 0.
TIMEOUT_LLM_S=120
# Rodadas de verificação (grafo do LangGraph, docs/DECISOES.md §14 e §16). Nova rodada só se a
# anterior falhou e se ela cabe no orçamento de tempo total da pergunta.
RODADAS_MAX=3
ORCAMENTO_S=150
# Fração mínima dos termos de cada afirmação que precisa estar no trecho citado.
FUNDAMENTACAO_MIN_TERMOS=0.6
# F4 (docs/DECISOES.md §37): resposta menos robótica. LINGUAGEM_SIMPLES=false volta ao prompt anterior
# (para comparar no benchmark completo). EXPLICAR_INDICACAO: no "para que serve", o modelo explica em
# palavras simples as frases copiadas da bula (uma chamada a mais; reprovada, sai só a cópia).
LINGUAGEM_SIMPLES=true
EXPLICAR_INDICACAO=true
EXPLICACAO_MIN_TERMOS=0.8

# --- API ---
CORS_ORIGENS=http://localhost:5173
MEDICAMENTOS_CONHECIDOS=data/medicamentos_conhecidos.txt
CATALOGO_ANVISA=data/processed/catalogo_anvisa.jsonl
ALIASES_IGNORADOS=data/aliases_ignorados.txt

# --- Dataset em arquivo e cache de embeddings (data/cache fica fora do Git) ---
BULAS_DIR=data/processed/bulas
CHUNKS_ARQUIVO=data/processed/chunks.jsonl
CACHE_EMBEDDINGS=data/cache/embeddings.sqlite
