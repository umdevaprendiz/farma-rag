# Copie para .env (que fica fora do Git) e ajuste.
# Tudo que muda entre experimentos fica aqui, nunca fixo no código.

# --- Ollama (nativo no Windows; o container enxerga via host.docker.internal) ---
OLLAMA_URL=http://localhost:11434
# Esta máquina não tem GPU NVIDIA: tudo roda na CPU. Comece com 1-2B e deixe o benchmark decidir.
LLM_MODELO=qwen2.5:1.5b
EMBED_MODELO=bge-m3
# Precisa bater com a coluna vector(N) em chunks
EMBED_DIM=1024

# --- MySQL 8 (troque para PostgreSQL + pgvector depois, se quiser: ver docs/DECISOES.md) ---
DB_USER=farmarag
DB_PASSWORD=troque-esta-senha
DB_NAME=farmarag
# Só usada pelo container MySQL do docker-compose para criar o banco
DB_ROOT_PASSWORD=troque-esta-senha-root
# "localhost" para scripts rodados no host (ingestão, benchmark, pytest).
# O docker-compose.yml sobrescreve para "db":3306 dentro do container da API.
DB_HOST=localhost
# Porta publicada no host
DB_PORT=3306

# --- Busca e geração ---
TOP_K=3
# Vazio = ainda não calibrado (etapa 2/4). Escolher com as 10 perguntas sem resposta do benchmark.
LIMIAR_SIMILARIDADE=
CHUNK_TOKENS=300
CHUNK_SOBREPOSICAO=50
TEMPERATURA=0.1
NUM_CTX=4096
NUM_PREDICT=250
# Em CPU a geração é lenta; ajuste depois de medir na etapa 0.
TIMEOUT_LLM_S=120

# --- API ---
CORS_ORIGENS=http://localhost:5173
MEDICAMENTOS_CONHECIDOS=data/medicamentos_conhecidos.txt
